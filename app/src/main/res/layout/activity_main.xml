<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/holo_blue_light"
    android:padding="16dp">

 <!-- Línea divisoria superior -->
 <View
     android:id="@+id/divsion"
     android:layout_width="match_parent"
     android:layout_height="0dp"
     android:layout_marginBottom="16dp"
     android:background="@android:color/white" />

 <!-- Título de la app -->
 <TextView
     android:id="@+id/tituloApp"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_below="@id/divsion"
     android:layout_centerHorizontal="true"
     android:layout_marginTop="8dp"
     android:text="Rastreador de Gastos"
     android:textColor="#ffffff"
     android:textSize="22sp"
     android:textStyle="bold"
     android:fontFamily="sans-serif-medium" />

 <!-- Botones con scroll horizontal -->
 <HorizontalScrollView
     android:id="@+id/cintaBotones"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_below="@id/tituloApp"
     android:layout_marginTop="12dp"
     android:fillViewport="true"
     android:scrollbars="none">

  <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">

   <Button
       android:id="@+id/btnVerGraficosdesdeGastos"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginEnd="12dp"
       android:background="@drawable/rounded_button_dark"
       android:text="📊 Gráficos"
       android:textColor="@android:color/white"
       android:elevation="3dp"
       android:paddingLeft="16dp"
       android:paddingRight="16dp" />

   <Button
       android:id="@+id/btnCerrarSesion"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_marginEnd="12dp"
       android:background="@drawable/rounded_button_dark"
       android:text="🚪 Salir"
       android:textColor="@android:color/white"
       android:elevation="3dp"
       android:paddingLeft="16dp"
       android:paddingRight="16dp" />



   <Button
       android:id="@+id/btnAgregarIngreso"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:background="@drawable/rounded_button_dark"
       android:text="💰 Agregar Ingreso"
       android:textColor="@android:color/white"
       android:elevation="3dp"
       android:paddingLeft="16dp"
       android:paddingRight="16dp" />


  </LinearLayout>
 </HorizontalScrollView>

 <!-- Usuario y Total -->
 <RelativeLayout
     android:id="@+id/contenedorUsuario"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_below="@id/cintaBotones"
     android:layout_marginTop="20dp">

  <TextView
      android:id="@+id/txtNombredeUsuarioPrincipal"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentStart="true"
      android:layout_centerVertical="true"
      android:layout_marginStart="16dp"
      android:text="Usuario:"
      android:textSize="16sp"
      android:textColor="#ffffff"
      android:fontFamily="sans-serif" />

  <TextView
      android:id="@+id/gastoTotal"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentEnd="true"
      android:layout_centerVertical="true"
      android:text="Gasto Total: $0.00"
      android:textColor="#f0f0f0"
      android:textSize="15sp"
      android:fontFamily="sans-serif-light" />
 </RelativeLayout>

 <!-- Sección de ingreso -->
 <RelativeLayout
     android:id="@+id/contenedorDatos"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_below="@id/contenedorUsuario"
     android:layout_marginTop="24dp"
     android:background="@android:color/white"
     android:padding="16dp"
     android:elevation="4dp">

  <Spinner
      android:id="@+id/spncategoria"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="12dp"
      android:entries="@array/categorias" />

  <EditText
      android:id="@+id/txtfechaGasto"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_below="@id/spncategoria"
      android:layout_marginTop="8dp"
      android:hint="Fecha"
      android:inputType="date"
      android:padding="10dp"
      android:backgroundTint="#c0c0c0" />

  <EditText
      android:id="@+id/txtconceptoGasto"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_below="@id/txtfechaGasto"
      android:layout_marginTop="8dp"
      android:hint="Concepto"
      android:inputType="text"
      android:padding="10dp"
      android:backgroundTint="#c0c0c0" />

  <EditText
      android:id="@+id/txtTotal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_below="@id/txtconceptoGasto"
      android:layout_marginTop="8dp"
      android:hint="Monto en $"
      android:inputType="numberDecimal"
      android:padding="10dp"
      android:backgroundTint="#c0c0c0" />

  <ImageButton
      android:id="@+id/imgFotoFactura"
      android:layout_width="100dp"
      android:layout_height="100dp"
      android:layout_below="@id/txtTotal"
      android:layout_centerHorizontal="true"
      android:layout_marginTop="20dp"
      android:backgroundTint="@android:color/holo_blue_light"
      android:padding="12dp"
      android:src="@mipmap/ic_launcher_round"
      android:contentDescription="Foto factura" />

  <Button
      android:id="@+id/btnguardarGasto"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_below="@id/imgFotoFactura"
      android:layout_marginTop="20dp"
      android:backgroundTint="@android:color/holo_blue_light"
      android:text="Guardar Gasto"
      android:textColor="@android:color/white"
      android:elevation="2dp" />

  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/fabVerGastos"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentEnd="true"
      android:layout_alignParentBottom="true"
      android:layout_margin="24dp"
      android:contentDescription="Ver Gastos"
      android:src="@android:drawable/ic_menu_view"
      app:tint="@android:color/white"
      android:backgroundTint="@android:color/holo_blue_dark"
      app:rippleColor="@android:color/darker_gray" />
 </RelativeLayout>

</RelativeLayout>