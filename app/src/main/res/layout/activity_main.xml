<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

 <ScrollView
     android:id="@+id/scrollContainer"
     android:layout_width="match_parent"
     android:layout_height="match_parent">

  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="16dp">

   <View
       android:id="@+id/divsion"
       android:layout_width="match_parent"
       android:layout_height="10dp"
       android:layout_margin="10dp"
       android:background="#01c5bb" />

   <TextView
       android:id="@+id/tituloApp"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_below="@id/divsion"
       android:layout_centerHorizontal="true"
       android:layout_marginBottom="20dp"
       android:layout_marginTop="10dp"
       android:fontFamily="monospace"
       android:text="Rastreador de Gastos"
       android:textColor="#01c5bb"
       android:textSize="24sp"
       android:textStyle="bold" />

   <Button
       android:id="@+id/verGraficos"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_below="@id/tituloApp"
       android:layout_centerHorizontal="true"
       android:layout_marginBottom="20dp"
       android:backgroundTint="#01c5bb"
       android:onClick="irAGraficas"
       android:text="Ver Gráficos de Gastos"
       android:textColor="@android:color/white" />

   <!-- Fila usuario y total -->
   <RelativeLayout
       android:id="@+id/contenedorUsuario"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_below="@id/verGraficos"
       android:layout_marginBottom="20dp">

    <Button
        android:id="@+id/dropdownMenuButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:text="Nombre del Usuario"
        android:textSize="18sp"
        android:textColor="#495057"
        style="?android:attr/borderlessButtonStyle" />

    <TextView
        android:id="@+id/gastoTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:text="Gasto Total: $0.00"
        android:textColor="#6c757d"
        android:textSize="16sp" />
   </RelativeLayout>

   <!-- Sección de ingreso de datos -->
   <RelativeLayout
       android:id="@+id/contenedorDatos"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_below="@id/contenedorUsuario"
       android:layout_marginTop="20dp"
       android:background="#F8F8F8"
       android:padding="16dp"
       android:elevation="2dp">

    <Spinner
        android:id="@+id/spncategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/txtfechaGasto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/spncategoria"
        android:layout_marginBottom="10dp"
        android:hint="Fecha"
        android:inputType="date" />

    <EditText
        android:id="@+id/txtconceptoGasto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtfechaGasto"
        android:layout_marginBottom="10dp"
        android:hint="Concepto"
        android:inputType="text" />

    <EditText
        android:id="@+id/txtTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtconceptoGasto"
        android:layout_marginBottom="10dp"
        android:hint="0.00"
        android:inputType="numberDecimal" />

    <ImageButton
        android:id="@+id/imgFotoFactura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtTotal"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:backgroundTint="#01c5bb"
        android:padding="10dp"
        android:src="@mipmap/ic_launcher_round" />

    <Button
        android:id="@+id/btnguardarGasto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgFotoFactura"
        android:layout_marginTop="20dp"
        android:backgroundTint="#16b7bd"
        android:text="Guardar"
        android:textColor="@android:color/white" />
   </RelativeLayout>

   <!-- Sección búsqueda -->
   <RelativeLayout
       android:id="@+id/contenedorBusqueda"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_below="@id/contenedorDatos"
       android:layout_marginTop="20dp"
       android:background="#F8F8F8"
       android:padding="16dp"
       android:elevation="2dp">

    <Spinner
        android:id="@+id/searchCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/searchDate"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:layout_alignTop="@id/searchDate"
        android:entries="@array/categorias" />

    <EditText
        android:id="@+id/searchDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_weight="1"
        android:hint="Fecha"
        android:inputType="date" />

    <Button
        android:id="@+id/btnbuscarGastos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:backgroundTint="#01c5bb"
        android:onClick="buscarGastos"
        android:text="Buscar"
        android:textColor="@android:color/white" />

    <ListView
        android:id="@+id/tablaGastos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnbuscarGastos"
        android:layout_marginTop="16dp" />
   </RelativeLayout>
  </RelativeLayout>
 </ScrollView>
</RelativeLayout>
