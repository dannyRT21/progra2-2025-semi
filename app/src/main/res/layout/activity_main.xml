<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

 <!-- Línea divisoria superior -->
 <View
     android:id="@+id/divsion"
     android:layout_width="match_parent"
     android:layout_height="8dp"
     android:layout_marginBottom="16dp"
     android:background="#01c5bb" />

 <!-- Título de la app -->
 <TextView
     android:id="@+id/tituloApp"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_below="@id/divsion"
     android:layout_centerHorizontal="true"
     android:layout_marginTop="8dp"
     android:text="Rastreador de Gastos"
     android:textColor="#01c5bb"
     android:textSize="22sp"
     android:textStyle="bold"
     android:fontFamily="monospace" />

 <!-- Botón Ver Gráficos -->
 <Button
     android:id="@+id/verGraficos"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_below="@id/tituloApp"
     android:layout_centerHorizontal="true"
     android:layout_marginTop="12dp"
     android:backgroundTint="#01c5bb"
     android:onClick="irAGraficas"
     android:text="Ver Gráficos de Gastos"
     android:textColor="@android:color/white" />

 <!-- Usuario y Total -->
 <RelativeLayout
     android:id="@+id/contenedorUsuario"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_below="@id/verGraficos"
     android:layout_marginTop="20dp">

  <Button
      android:id="@+id/dropdownMenuButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentStart="true"
      android:text="Nombre del Usuario"
      android:textSize="16sp"
      android:textColor="#495057"
      style="?android:attr/borderlessButtonStyle" />

  <TextView
      android:id="@+id/gastoTotal"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentEnd="true"
      android:layout_centerVertical="true"
      android:text="Gasto Total: $0.00"
      android:textColor="#6c757d"
      android:textSize="15sp" />
 </RelativeLayout>

 <!-- Sección de ingreso -->
 <RelativeLayout
     android:id="@+id/contenedorDatos"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_below="@id/contenedorUsuario"
     android:layout_marginTop="24dp"
     android:background="#F8F8F8"
     android:padding="16dp"
     android:elevation="2dp">

  <Spinner
      android:id="@+id/spncategoria"
      android:entries="@array/categorias"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="12dp" />

  <EditText
      android:id="@+id/txtfechaGasto"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_below="@id/spncategoria"
      android:layout_marginTop="8dp"
      android:hint="Fecha"
      android:inputType="date" />

  <EditText
      android:id="@+id/txtconceptoGasto"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_below="@id/txtfechaGasto"
      android:layout_marginTop="8dp"
      android:hint="Concepto"
      android:inputType="text" />

  <EditText
      android:id="@+id/txtTotal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_below="@id/txtconceptoGasto"
      android:layout_marginTop="8dp"
      android:hint="0.00"
      android:inputType="numberDecimal" />

  <ImageButton
      android:id="@+id/imgFotoFactura"
      android:layout_width="100dp"
      android:layout_height="100dp"
      android:layout_below="@id/txtTotal"
      android:layout_centerHorizontal="true"
      android:layout_marginTop="20dp"
      android:backgroundTint="#01c5bb"
      android:padding="12dp"
      android:src="@mipmap/ic_launcher_round"
    />

  <Button
      android:id="@+id/btnguardarGasto"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_below="@id/imgFotoFactura"
      android:layout_marginTop="20dp"
      android:backgroundTint="#16b7bd"
      android:text="Guardar"
      android:textColor="@android:color/white" />

  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/fabVerGastos"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentEnd="true"
      android:layout_alignParentBottom="true"
      android:layout_margin="24dp"
      android:src="@android:drawable/ic_input_add"
      app:backgroundTint="@android:color/holo_blue_light"
      app:rippleColor="@android:color/darker_gray" />
 </RelativeLayout>

</RelativeLayout>
