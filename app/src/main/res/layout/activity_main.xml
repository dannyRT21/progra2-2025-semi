<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

 <ScrollView
     android:layout_width="match_parent"
     android:layout_height="match_parent">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

   <View
       android:id="@+id/divsion"
       android:layout_width="match_parent"
       android:layout_height="10dp"
       android:layout_margin="10dp"
       android:background="#01c5bb" />

   <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_gravity="center_horizontal"
       android:layout_marginBottom="20dp"
       android:fontFamily="monospace"
       android:text="Rastreador de Gastos"
       android:textColor="#01c5bb"
       android:textSize="24sp"
       android:textStyle="bold" />

   <Button
       android:id="@+id/verGraficos"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_gravity="center_horizontal"
       android:layout_marginBottom="20dp"
       android:backgroundTint="#01c5bb"
       android:onClick="irAGraficas"
       android:text="Ver Gráficos de Gastos"
       android:textColor="@android:color/white" />

   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="horizontal"
       android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

     <Button
         android:id="@+id/dropdownMenuButton"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:drawablePadding="8dp"
         android:text="Nombre del Usuario"
         android:textSize="18sp"
         android:textColor="#495057"
         style="?android:attr/borderlessButtonStyle" />

    </FrameLayout>

    <TextView
        android:id="@+id/gastoTotal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:text="Gasto Total: $0.00"
        android:textColor="#6c757d"
        android:textSize="16sp" />

   </LinearLayout>

   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:background="#F8F8F8"
       android:padding="16dp"
       android:layout_marginTop="20dp"
       android:elevation="2dp">

    <Spinner
        android:id="@+id/spncategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/lblfecha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="date"
        android:hint="Fecha"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/lblconcepto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:hint="Concepto"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/lbltotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="0.00"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnguardarGasto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#16b7bd"
        android:text="Guardar"
        android:textColor="@android:color/white" />

   </LinearLayout>

   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:background="#F8F8F8"
       android:padding="16dp"
       android:layout_marginTop="20dp"
       android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

     <Spinner
         android:id="@+id/searchCategory"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:layout_marginEnd="8dp" />

     <EditText
         android:id="@+id/searchDate"
         android:layout_width="0dp"
         android:layout_height="wrap_content"
         android:layout_weight="1"
         android:inputType="date"
         android:hint="Fecha"
         android:layout_marginEnd="8dp" />

     <Button
         android:id="@+id/btnbuscarGastos"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:backgroundTint="#01c5bb"
         android:onClick="buscarGastos"
         android:text="Buscar"
         android:textColor="@android:color/white" />

    </LinearLayout>

    <ListView
        android:id="@+id/tablaGastos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />
   </LinearLayout>

  </LinearLayout>
 </ScrollView>
</RelativeLayout>