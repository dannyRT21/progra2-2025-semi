<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp">


    <TextView
        android:id="@+id/tituloApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="Registro de Ingresos"
        android:textColor="@color/material_dynamic_neutral30"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />


    <HorizontalScrollView
        android:id="@+id/cintaBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tituloApp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnVerGraficos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rounded_button_primary"
                android:text="📊 Gráficos"
                android:textColor="@color/black"
                android:elevation="2dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/btnAgregarGasto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rounded_button_accent"
                android:text="➖ Gastos"
                android:textColor="@color/black"
                android:elevation="2dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />

            <Button
                android:id="@+id/btnsalir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_button_primary"
                android:text="X salir"
                android:textColor="@color/black"
                android:elevation="2dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>
    </HorizontalScrollView>


    <RelativeLayout
        android:id="@+id/contenedorUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cintaBotones"
        android:layout_marginTop="16dp"
        android:paddingVertical="8dp"
        android:background="@color/material_on_surface_stroke">

        <TextView
            android:id="@+id/txtNombredeUsuarioPrincipal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:text="Usuario:"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/ingresoTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:text="Total: $0.00"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif" />
    </RelativeLayout>


    <LinearLayout
        android:id="@+id/contenedorDatos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/contenedorUsuario"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="24dp"
        android:elevation="4dp">


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="Fuente de Ingreso">

            <EditText
                android:id="@+id/txtFuentedeIngreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="Fecha">

            <EditText
                android:id="@+id/txtfechaIngreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:textColor="@android:color/black" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="Descripción">

            <EditText
                android:id="@+id/txtdescripcionIngreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="Monto">

            <EditText
                android:id="@+id/txtMontoIngreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>


        <Button
            android:id="@+id/btnGuardarIngreso"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/black"
            android:text="GUARDAR INGRESO"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:elevation="2dp"
            android:fontFamily="sans-serif-medium"/>


        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabVerIngresos"
            android:layout_width="123dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="24dp"
            android:backgroundTint="@android:color/holo_green_dark"
            android:contentDescription="Ver Ingresos"
            android:src="@android:drawable/ic_menu_view"
            app:rippleColor="@android:color/darker_gray"
            app:tint="@android:color/white" />
    </LinearLayout>
</RelativeLayout>
